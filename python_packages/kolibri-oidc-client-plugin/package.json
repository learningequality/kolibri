{
  "scripts": {
    "build": "kolibri-build prod --plugins kolibri_oidc_client_plugin",
    "clean": "kolibri-build clean --plugins kolibri_oidc_client_plugin",
    "dev": "kolibri-build dev --plugins kolibri_oidc_client_plugin",
    "lint-frontend": "kolibri-format --pattern 'kolibri_oidc_client_plugin/**/*.{js,vue,scss,less,css}' --ignore '**/dist/**' '**/node_modules/**' '**/static/**'",
    "lint-frontend:format": "pnpm run lint-frontend --write"
  },
  "name": "kolibri-oidc-client-plugin",
  "description": "OpenID Client plugin for Kolibri",
  "private": true,
  "dependencies": {
    "browserslist-config-kolibri": "workspace:*",
    "kolibri": "workspace:*",
    "kolibri-common": "workspace:*",
    "kolibri-design-system": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "kolibri-build": "workspace:*",
    "kolibri-format": "workspace:*"
  },
  "browserslist": [
    "extends browserslist-config-kolibri"
  ]
}
