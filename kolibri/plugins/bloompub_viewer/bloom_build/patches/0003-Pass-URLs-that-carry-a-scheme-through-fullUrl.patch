+        "blob:http://x.org/0b5e5c5a-3f43-4a0c-9d0e-4d8e3a1b2c3d",
+        "http://x.org/content/zipcontent/abc.bloompub/video/v.mp4",
+        "data:image/png;base64,iVBORw0KGgo=",
+    ])("returns %s unchanged", (url) => {
+        expect(fullUrl(url, "blob:http://x.org/book")).toBe(url);
+    });
+
+    it("prepends the book folder to a relative name containing a colon", () => {
+        expect(fullUrl("images/a:b.png", "http://x.org/book")).toBe(
+            "http://x.org/book/images/a:b.png",
+        );
+    });
 });
 
