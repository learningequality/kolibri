diff --git a/src/shared/urlScheme.ts b/src/shared/urlScheme.ts
new file mode 100644
index 0000000..67340db
--- /dev/null
+++ b/src/shared/urlScheme.ts
@@ -0,0 +1,4 @@
+// RFC 3986 section 3.1: scheme = ALPHA *( ALPHA / DIGIT / "+" / "-" / "." )
+export function hasUrlScheme(url: string): boolean {
+    return /^[a-z][a-z\d+.-]*:/i.test(url);
+}
diff --git a/src/stylesheets.test.ts b/src/stylesheets.test.ts
new file mode 100644
index 0000000..fae98d4
--- /dev/null
+++ b/src/stylesheets.test.ts
@@ -0,0 +1,46 @@
+import axios from "axios";
+import { BookInfo } from "./bookInfo";
+import { assembleStyleSheets } from "./stylesheets";
+
+vi.mock("axios", () => ({
+    default: {
+        get: vi.fn(() => Promise.resolve({ data: "", config: { url: "" } })),
+        all: (promises: Array<Promise<unknown>>) => Promise.all(promises),
+    },
+}));
+
+const mockedGet = vi.mocked(axios.get);
+
+function bookLinkingTo(href: string): HTMLHtmlElement {
+    return new DOMParser().parseFromString(
+        `<html><head><link rel="stylesheet" type="text/css" href="${href}"></head><body></body></html>`,
+        "text/html",
+    ).documentElement as HTMLHtmlElement;
+}
+
+describe("assembleStyleSheets", () => {
+    beforeEach(() => mockedGet.mockClear());
+
+    it("fetches a relative href from the book folder", async () => {
+        await assembleStyleSheets(
+            bookLinkingTo("basePage.css"),
+            "http://x.org/book",
+            new BookInfo(),
+            () => null,
+        );
+        expect(mockedGet).toHaveBeenCalledWith(
+            "http://x.org/book/basePage.css",
+        );
+    });
+
+    it("fetches an href that carries a scheme unchanged", async () => {
+        const href = "blob:http://x.org/0b5e5c5a-3f43-4a0c-9d0e-4d8e3a1b2c3d";
+        await assembleStyleSheets(
+            bookLinkingTo(href),
+            "blob:http://x.org/book",
+            new BookInfo(),
+            () => null,
+        );
+        expect(mockedGet).toHaveBeenCalledWith(href);
+    });
+});
