diff --git a/src/shared/urlScheme.ts b/src/shared/urlScheme.ts
index 67340db..98527ce 100644
--- a/src/shared/urlScheme.ts
+++ b/src/shared/urlScheme.ts
@@ -2,3 +2,12 @@
 export function hasUrlScheme(url: string): boolean {
     return /^[a-z][a-z\d+.-]*:/i.test(url);
 }
+
+export function audioFolderUrl(urlPrefix: string, fileName: string): string {
+    return hasUrlScheme(fileName) ? fileName : urlPrefix + "/audio/" + fileName;
+}
+
+// The File API looks a blob: URL up including its query, so a query makes the lookup fail.
+export function addQuery(url: string, query: string): string {
+    return url.startsWith("blob:") ? url : url + "?" + query;
+}
