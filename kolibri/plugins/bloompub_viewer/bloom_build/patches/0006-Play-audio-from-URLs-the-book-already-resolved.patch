diff --git a/src/music.test.ts b/src/music.test.ts
new file mode 100644
index 0000000..49ddd69
--- /dev/null
+++ b/src/music.test.ts
@@ -0,0 +1,35 @@
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { Music } from "./music";
+
+vi.mock("./videoRecordingSupport", () => ({
+    logSound: vi.fn(),
+    logSoundPaused: vi.fn(),
+    logSoundRepeat: vi.fn(),
+}));
+
+function playPageWithMusic(src: string): HTMLAudioElement {
+    document.body.innerHTML = `<div id="p1" class="bloom-page" data-backgroundaudio="${src}"></div>`;
+    const music = new Music();
+    music.urlPrefix = "https://host/book";
+    music.processAllMusicForBook(document.getElementsByClassName("bloom-page"));
+    music.HandlePageVisible(document.getElementById("p1")!);
+    return document.getElementById("music-player") as HTMLAudioElement;
+}
+
+describe("Music", () => {
+    afterEach(() => {
+        document.body.innerHTML = "";
+    });
+
+    test("plays a file name from the book's audio folder", () => {
+        expect(playPageWithMusic("tune.mp3").getAttribute("src")).toMatch(
+            /^https:\/\/host\/book\/audio\/tune\.mp3\?nocache=\d+$/,
+        );
+    });
+
+    test("plays a blob URL as given", () => {
+        expect(
+            playPageWithMusic("blob:https://host/3f2c").getAttribute("src"),
+        ).toBe("blob:https://host/3f2c");
+    });
+});
