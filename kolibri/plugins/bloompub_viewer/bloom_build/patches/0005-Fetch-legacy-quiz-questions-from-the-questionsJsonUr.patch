Date: Thu, 22 Oct 2026 04:34:33 +0000
Subject: [PATCH 05/11] Fetch legacy quiz questions from the questionsJsonUrl
 parameter

A blob: book URL has no folder to find questions.json in, so Kolibri passes its URL.
---
 .../LegacyQuizHandler.test.ts                 | 43 +++++++++++++++++++
 .../legacyQuizHandling/LegacyQuizHandler.ts   |  8 +++-
 src/bloom-player-controls.tsx                 |  5 +++
 src/bloom-player-core.tsx                     |  2 +
 4 files changed, 56 insertions(+), 2 deletions(-)
 create mode 100644 src/activities/legacyQuizHandling/LegacyQuizHandler.test.ts

diff --git a/src/activities/legacyQuizHandling/LegacyQuizHandler.test.ts b/src/activities/legacyQuizHandling/LegacyQuizHandler.test.ts
new file mode 100644
index 0000000..fd60d20
--- /dev/null
+++ b/src/activities/legacyQuizHandling/LegacyQuizHandler.test.ts
@@ -0,0 +1,43 @@
+import axios from "axios";
+import { LegacyQuestionHandler } from "./LegacyQuizHandler";
+
+vi.mock("axios", () => ({
+    default: { get: vi.fn(() => Promise.resolve({ data: "[]" })) },
+}));
+
+const mockedGet = vi.mocked(axios.get);
+
+function generateQuizPages(handler: LegacyQuestionHandler): Promise<void> {
+    const body = new DOMParser().parseFromString(
+        `<html><body><div class="bloom-backMatter"></div></body></html>`,
+        "text/html",
+    ).body;
+    return new Promise((finished) =>
+        handler.generateQuizPagesFromLegacyJSON(
+            "http://x.org/book",
+            body,
+            "",
+            finished,
+        ),
+    );
+}
+
+describe("LegacyQuestionHandler", () => {
+    beforeEach(() => mockedGet.mockClear());
+
+    it("fetches questions.json from the book folder", async () => {
+        await generateQuizPages(new LegacyQuestionHandler(""));
+        expect(mockedGet).toHaveBeenCalledWith(
+            "http://x.org/book/questions.json",
+        );
+    });
+
+    it("fetches the given questionsJsonUrl", async () => {
+        const questionsJsonUrl =
+            "blob:http://x.org/0b5e5c5a-3f43-4a0c-9d0e-4d8e3a1b2c3d";
+        await generateQuizPages(
+            new LegacyQuestionHandler("", questionsJsonUrl),
+        );
+        expect(mockedGet).toHaveBeenCalledWith(questionsJsonUrl);
+    });
+});
