+// A host that rewrites a link's href, such as Kolibri to a blob: URL, keeps the
+// book's own href in data-original-href.
+function linkedFileName(link: HTMLElement): string {
+    const href =
+        link.getAttribute("data-original-href") ?? link.getAttribute("href")!;
+    return href.split("/").pop()!;
+}
