[CustomMessages]
installservicetask=Jalankan Kolibri secara otomatis saat komputer dinyalakan
newerversioninstalled="Versi lebih baru dari {#AppName} (%1) sudah diinstal. Penginstal ini memiliki versi %2, yang lebih lama. Penyiapan akan keluar sekarang."
sameversioninstalled=Versi %1 telah diinstal. Ingin memperbaiki penginstalan dengan menginstalnya ulang?
olderversioninstalled="Versi lebih lama dari {#AppName} (%1) terdetekti. Ingin meningkatkan ke versi {#AppVersion}?"
confirmuninstalldata=Ingin menghapus total data pengguna Kolibri? Ini termasuk semua konten yang diunduh, akun pengguna, dan kemajuan. Proses ini tidak dapat diurungkan.
criticalerror=Kesalahan kritis terjadi saat mencoba menjalankan perintah penyiapan: %1. Penginstalan tidak dapat dilanjutkan.
commanderror=Perintah yang dibutuhkan untuk penyiapan gagal dijalankan secara benar: %1. Kode Kesalahan: %2. Penginstalan tidak dapat dilanjutkan.
versionparseerror=Tidak dapat membandingkan versi karena format versi tidak valid. Harap urungkan penginstalan versi sebelumnya secara manual dan coba lagi.
migrationfailed=Penginstal gagal memindahkan data pengguna dari lokasi lama (%1) ke lokasi baru (%2). Datamu belum dipindahkan. Harap hubungi dukungan untuk bantuan.
createdesktopicon=Buat ikon &desktop
additionalicons=Ikon tambahan:
launchprogram=Luncurkan %1
installationtype=Jenis Penginstalan:
