[CustomMessages]
installservicetask=Ejecutar Kolibri automáticamente cuando el ordenador se inicie
newerversioninstalled="Una versión más reciente de {#AppName} (%1) ya está instalada. Este instalador contiene la versión %2, que es más antigua. La instalación se cerrará."
sameversioninstalled=Esta versión de %1 ya está instalada. ¿Quieres reparar la instalación volviendo a instalar?
olderversioninstalled="Se detectó una versión anterior de {#AppName} (%1). ¿Quieres actualizar a la versión {#AppVersion}?"
confirmuninstalldata=¿Desea eliminar completamente todos los datos de usuario de Kolibri? Esto incluye todo el contenido descargado, las cuentas de usuario y el progreso, y no se puede deshacer.
criticalerror=Ocurrió un error crítico mientras se trataba de ejecutar un comando: %1. La instalación no puede continuar.
commanderror=No se pudo ejecutar correctamente un comando requerido: %1. Código de error: %2. La instalación no puede continuar.
versionparseerror=No se pudo comparar las versiones debido a un formato de versión no válido. Por favor, desinstale la versión anterior manualmente y vuelva a intentarlo.
migrationfailed=El instalador no ha podido migrar los datos del usuario desde la antigua ubicación (%1) a la nueva ubicación (%2). Tus datos no se han transferido. Póngase en contacto con el servicio de asistencia técnica.
createdesktopicon=Crear icono en el &escritorio
additionalicons=Iconos adicionales:
launchprogram=Iniciar %1
installationtype=Tipo de instalación:

