[CustomMessages]
installservicetask=Fara gudanar Kolibri kai tsaye da zarar an kunna kwamfuta
newerversioninstalled="An riga an shigar {#AppName} (%1) da sabuwar sigar. Wannan na ɗauke da sigar %2, wadda ta gabata. Yanzu za a rufe tsarin shigarwa."
sameversioninstalled=An riga an shigar da wannan sigar %1. Ka na son gyara shigarwar ta hanyar sake shigar da ita?
olderversioninstalled="An gano tsohuwar sigar {#AppName} (%1). Ku na son a sabunta ta zuwa {#AppVersion}?"
confirmuninstalldata=Ku na son goge dukkan bayanan masu amfani da Kolibri gaba ɗaya? Wannan ya haɗa da duk abubuwan da aka sauke, shafin masu amfani da shi da kuma bayanan su. Ba za a iya dawo da su ba idan an goge.
criticalerror=An sami kuskure babba yayin ƙoƙarin aiwatar da umarnin shigarwa: %1. Ba za a iya ci gaba da shigarwar ba.
commanderror=An kasa aiwatar da umarnin da ake buƙata don shigarwa yadda ya kamata: %1. Lambar kuskure: %2. Ba za a iya ci gaba da shigarwar ba.
versionparseerror=An kasa kwatanta sigogin saboda tsarin rubuta sigar bai dace ba. Da fatan za a cire tsohuwar sigar, sannan a sake gwadawa.
migrationfailed=Mai shigarwa ya kasa sauya da bayanan masu amfani daga tsohon wurin (%1) zuwa sabon wurin (%2). Ba a sauya da bayanan ku ba. Da fatan za a tuntuɓi sashen taimako don samun taimako.
createdesktopicon=Ƙirƙiri alamar manhaja a kan kwamfuta
additionalicons=Ƙarin wasu alamomi:
launchprogram=Kaddamar da %1
installationtype=Nau'in Shigarwa:
