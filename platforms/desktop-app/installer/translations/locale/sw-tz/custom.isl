[CustomMessages]
installservicetask=Endesha Kolibri kiotomatiki wakati kompyuta ikianza
newerversioninstalled="Toleo jipya zaidi la {#AppName} (%1) limesakinishwa tayari. Kisakinishi hiki kina toleo %2, ambalo ni la zamani zaidi. Usakinishaji sasa utakoma."
sameversioninstalled=Nakala hii ya %1 imeshasakinishwa. Je, ungependa kurekebisha usakinishaji huo kwa kusakinisha tena?
olderversioninstalled="Nakala ya awali ya {#AppName} (%1) imegunduliwa. Je, ungependa kusasisha hadi nakala ya {#AppVersion}?"
confirmuninstalldata=Je, unataka kufuta kabisa data zote za mtumiaji wa Kolibri? Hii inajumuisha maudhui yote yaliyopakuliwa, akaunti za watumiaji, na hatua, na kitendo hiki hakiwezi kutenduliwa.
criticalerror=Hitilafu kubwa imetokea wakati wa kujaribu kutekeleza amri ya usanidi: %1. Usakinishaji hauwezi kuendelea.
commanderror=Amri inayohitajika kwa ajili ya usanidi imeshindwa kutekelezwa ipasavyo: %1. Msimbo wa Hitilafu: %2. Usakinishaji hauwezi kuendelea.
versionparseerror=Imeshindwa kulinganisha nakala kwa sababu ya umbo la nakala lisilo sahihi. Tafadhali ondoa nakala ya awali wewe mwenyewe kisha ujaribu tena.
migrationfailed=Kisakinishi kimeshindwa kuhamisha data ya mtumiaji kutoka eneo la zamani (%1) hadi eneo jipya (%2). Data yako haijahamishwa. Tafadhali wasiliana na usaidizi kwa usaidizi.
createdesktopicon=Unda ikoni ya kompyuta
additionalicons=Ikono zaidi:
launchprogram=Zindua %1
installationtype=Aina ya Uwekaji:
