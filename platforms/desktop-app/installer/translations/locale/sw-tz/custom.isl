[CustomMessages]
installservicetask=Sakinisha Kolibri kiotomatiki wakati kompyuta inapoanza
newerversioninstalled="Toleo jipya zaidi la {#AppName} (%1) tayari limesakinishwa. Kisakinishi hiki kina toleo la %2, ambalo ni la zamani zaidi. Usakinishaji sasa utakoma."
sameversioninstalled=Toleo hili la %1 limeshasakinishwa. Je, ungependa kurekebisha usakinishaji huo kwa kulisakinisha tena?
olderversioninstalled="Toleo la awali la {#AppName} (%1) limegunduliwa. Je, ungependa kusasisha toleo jipya zaidi la {#AppVersion}?"
confirmuninstalldata=Je, ungependa kufuta kabisa data zote za mtumiaji wa Kolibri? Hii inajumuisha maudhui yote yaliyopakuliwa, akaunti za watumiaji, na hatua, na kitendo hiki hakiwezi kutenduliwa.
criticalerror=Hitilafu kubwa imetokea wakati wa kujaribu kutekeleza amri ya usanidi: %1. Usakinishaji hauwezi kuendelea.
commanderror=Imeshindwa kutekeleza ipasavyo amri inayohitajika kwa ajili ya usanidi: %1. Msimbo wa Hitilafu: %2. Usakinishaji hauwezi kuendelea.
versionparseerror=Imeshindwa kulinganisha matoleo kwa sababu ya umbo la toleo lisilo sahihi. Tafadhali ondoa toleo la awali wewe mwenyewe kisha ujaribu tena.
migrationfailed=Kisakinishi kimeshindwa kuhamisha data ya mtumiaji kutoka eneo la zamani (%1) hadi eneo jipya (%2). Data yako haijahamishwa. Tafadhali wasiliana na timu ya usaidizi ili upate usaidizi.
createdesktopicon=Unda aikoni ya kompyuta
additionalicons=Aikoni zaidi:
launchprogram=Zindua %1
installationtype=Aina ya Usakinishaji:
