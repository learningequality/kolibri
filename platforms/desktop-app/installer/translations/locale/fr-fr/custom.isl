[CustomMessages]
installservicetask=Lancer Kolibri automatiquement au démarrage de l'ordinateur
newerversioninstalled="Une version plus récente de {#AppName} (%1) est déjà installée. Cet assistant d'installation contient la version %2, plus ancienne. L'installation va à présent se fermer."
sameversioninstalled=Cette version de %1 est déjà installée. Voulez-vous réparer l'installation en la réinstallant ?
olderversioninstalled="Une ancienne version de {#AppName} (%1) a été détectée. Souhaitez-vous effectuer la mise à jour en installant la version {#AppVersion} ?"
confirmuninstalldata=Voulez-vous supprimer complètement toutes les données utilisateur de Kolibri ? Cela inclut l'ensemble du contenu téléchargé, les comptes utilisateur et la progression. L'opération ne peut pas être annulée.
criticalerror=Une erreur critique s'est produite lors de l'exécution d'une commande d'installation : %1. L'installation ne peut se poursuivre.
commanderror=Une commande requise pour l'installation n'a pas pu s'exécuter correctement : %1. Code d'erreur : %2. L'installation ne peut se poursuivre.
versionparseerror=Impossible de comparer les versions en raison d'un format de version non valide. Veuillez désinstaller manuellement la version précédente et réessayer.
migrationfailed=L'assistant d'installation n'a pas réussi à migrer les données utilisateur de l'ancien emplacement (%1) vers le nouvel emplacement (%2). Vos données n'ont pas été déplacées. Veuillez contacter le service d'assistance pour obtenir de l'aide.
createdesktopicon=Créer une icône sur le bureau
additionalicons=Icônes supplémentaires :
launchprogram=Lancer %1
installationtype=Type d’installation :
