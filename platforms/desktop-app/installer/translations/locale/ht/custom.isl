[CustomMessages]
installservicetask=Lanse Kolibri otomatikman lè òdinatè a demare
newerversioninstalled="Yon nouvo vèsyon {#AppName} (%1) te deja enstale. Enstalatè sa a genyen vèsyon %2, ki pi ansyen. Yo pral fèmen enstalasyon sa a kounye a."
sameversioninstalled=Vèsyon sa a pou %1 te deja enstale. Èske w vle repare enstalasyon sa a lè w reyenstale l?
olderversioninstalled="Yon ansyen vèsyon pou {#AppName} (%1) te detekte. Èske w vle mete l ajou pou vèsyon {#AppVersion}?"
confirmuninstalldata=Èske w vle totalman retire tout done itilizatè Kolibri yo? Sa enkli tout kontni, kont itilizatè, ak pwogrè, epi pa ka defèt.
criticalerror=Yon erè kritik te rive pandan yo t ap eseye ekzekite kòmann konfigirasyon: %1. Enstalasyon an p ap ka kontinye.
commanderror=Yon kòmann ki nesesè pou konfigirasyon pa t rive ekzekite kòrèkteman: %1. Kòd Erè: %2. Enstalsyon an p ap ka kontinye.
versionparseerror=Pa t ka konpare vèsyon yo akoz fòma vèsyon ki envalid. Tanpri dezenstale vèsyon presedan an manyèlman epi eseye ankò.
migrationfailed=Enstalatè a pa t rive migre done itilizatè yo soti nan ansyen lokal la (%1) pou ale nan nouvo lokal la (%2). Yo pa t deplase done ou yo.Tanpri kontakte sipò pou asistans.
createdesktopicon=Kreye yon ikón nan &biwo
additionalicons=Ikón adisyonèl:
launchprogram=Lanse %1
installationtype=Tip Enstalasyon:
