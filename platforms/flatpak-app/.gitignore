__pycache__

# Ignore all top-level dotfiles; opt in the ones that belong in git.
/.*
!/.editorconfig
!/.github/
!/.gitignore

# Meson build
/build

# Flatpak build
.flatpak-builder/
_flatpak/
_repo/
*.flatpak

# Generated Kolibri module manifest + downloaded wheels (build-time inputs)
/build-aux/flatpak/modules/python3-kolibri.json
/build-aux/flatpak/modules/*.whl
