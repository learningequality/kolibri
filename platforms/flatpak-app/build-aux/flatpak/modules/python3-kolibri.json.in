{
    "name": "python3-kolibri",
    "buildsystem": "simple",
    "build-commands": [
        "pip3 install --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} kolibri",
        "patch -d ${KOLIBRI_MODULE_PATH}/dist/ifcfg -p3 < 0001-Remove-needless-ifcfg-warning.patch"
    ],
    "sources": [
        {
            "type": "file",
            "path": "python3-kolibri-patches/dist_ifcfg/0001-Remove-needless-ifcfg-warning.patch"
        }
    ]
}
