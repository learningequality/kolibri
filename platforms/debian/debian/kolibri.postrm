#!/bin/bash

set -e

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.
#SCRIPTSCOMMON#

case "$1" in
    remove|purge)
        # /opt/kolibri/python is extracted by install-python.sh at postinst
        # time, so dpkg does not track it and will not remove it for us.
        rm -rf /opt/kolibri/python /opt/kolibri/python.new
        rm -rf /opt/kolibri/bundled
        # Remove /opt/kolibri if empty
        rmdir /opt/kolibri/bin 2>/dev/null || true
        rmdir /opt/kolibri 2>/dev/null || true
        ;;
esac

if [ "$1" = "purge" ]
then

    kolibri_purge

fi


# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.
#DEBHELPER#

