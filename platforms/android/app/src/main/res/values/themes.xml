<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Minimal AppCompat theme - satisfies Android requirements but stays invisible.
        All visual theming is handled by Kolibri's web interface.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- White window background for most screens -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        Android 15+ treats cutout mode never as always for non-floating windows
        targeting API 35+, while API 28-34 still honors never.
    -->
    <style name="AppTheme.Fullscreen" parent="AppTheme" tools:targetApi="28">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
</resources>
